# Lightweight Caddy reverse proxy for Label Studio
# Uses multi-stage build to copy static files from the app image.
# Build the app image first: docker compose build app
# Then build this:         docker compose build caddy
ARG APP_IMAGE=heartexlabs/label-studio:latest
FROM ${APP_IMAGE} AS app-source

FROM caddy:2-alpine

ENV LS_DIR=/label-studio \
    OPT_DIR=/opt/heartex/instance-data/etc

RUN set -eux; \
    apk add --no-cache bash; \
    mkdir -p $LS_DIR $OPT_DIR; \
    chown -R 1001:0 $LS_DIR $OPT_DIR

WORKDIR $LS_DIR

# Copy Caddy configuration and entrypoint scripts from app image
COPY --chown=1001:0 --from=app-source /label-studio/deploy/Caddyfile deploy/Caddyfile
COPY --chown=1001:0 --from=app-source /label-studio/deploy/docker-entrypoint.d/caddy/ deploy/docker-entrypoint.d/caddy/
COPY --chown=1001:0 --from=app-source /label-studio/deploy/docker-entrypoint.sh deploy/docker-entrypoint.sh

# Copy static files from the already-built app image
COPY --chown=1001:0 --from=app-source /label-studio/label_studio/core/static_build/ label_studio/core/static_build/
COPY --chown=1001:0 --from=app-source /label-studio/web/dist/ web/dist/

USER 1001

EXPOSE 8085

ENTRYPOINT ["/label-studio/deploy/docker-entrypoint.sh"]
CMD ["caddy"]
